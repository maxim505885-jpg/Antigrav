{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scan2bim.local/contracts/structural-model.schema.json",
  "title": "SCAN structural-member model 1.0",
  "type": "object",
  "required": ["schema", "units", "coordinate_frame", "members"],
  "properties": {
    "schema": {"const": "scan2bim.structural/1.0"},
    "units": {"const": "m"},
    "coordinate_frame": {
      "type": "object",
      "required": ["id", "units", "vertical_axis"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "units": {"const": "m"},
        "vertical_axis": {"enum": ["X", "Y", "Z"]}
      },
      "additionalProperties": true
    },
    "members": {"type": "array", "items": {"$ref": "#/$defs/member"}}
  },
  "$defs": {
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "matrix4": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
    },
    "member": {
      "type": "object",
      "required": ["id", "element_id", "project_id", "cloud_id", "role", "class_name", "axis", "local_frame", "cross_section", "assemblies", "measured_dimensions", "evidence", "method", "confidence", "review_state", "transforms"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "element_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "cloud_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "class_name": {"type": "string", "minLength": 1},
        "axis": {
          "type": "object", "required": ["start", "end"],
          "properties": {"start": {"$ref": "#/$defs/vector3"}, "end": {"$ref": "#/$defs/vector3"}},
          "additionalProperties": false
        },
        "local_frame": {"$ref": "#/$defs/matrix4"},
        "cross_section": {
          "type": "object", "required": ["kind"],
          "properties": {
            "kind": {"enum": ["catalog_profile", "arbitrary_polygon", "built_up", "circular", "stepped", "unknown"]},
            "profile_id": {"type": "string", "minLength": 1},
            "vertices_m": {"type": "array", "minItems": 3, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
            "components": {"type": "array", "minItems": 1, "items": {"type": "object"}},
            "diameter_m": {"type": "number", "exclusiveMinimum": 0},
            "segments": {"type": "array", "minItems": 1, "items": {"type": "object"}},
            "reason": {"type": "string", "minLength": 1}
          },
          "allOf": [
            {"if": {"properties": {"kind": {"const": "catalog_profile"}}, "required": ["kind"]}, "then": {"required": ["profile_id"]}},
            {"if": {"properties": {"kind": {"const": "arbitrary_polygon"}}, "required": ["kind"]}, "then": {"required": ["vertices_m"]}},
            {"if": {"properties": {"kind": {"const": "built_up"}}, "required": ["kind"]}, "then": {"required": ["components"]}},
            {"if": {"properties": {"kind": {"const": "circular"}}, "required": ["kind"]}, "then": {"required": ["diameter_m"]}},
            {"if": {"properties": {"kind": {"const": "stepped"}}, "required": ["kind"]}, "then": {"required": ["segments"]}},
            {"if": {"properties": {"kind": {"const": "unknown"}}, "required": ["kind"]}, "then": {"required": ["reason"]}}
          ],
          "additionalProperties": true
        },
        "assemblies": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "measured_dimensions": {"type": "object"},
        "evidence": {
          "type": "object",
          "properties": {
            "source_point_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}},
            "source_element_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": true
        },
        "method": {
          "type": "object", "required": ["name", "version", "parameters"],
          "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "parameters": {"type": "object"}},
          "additionalProperties": true
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "review_state": {"enum": ["unreviewed", "proposed", "confirmed", "corrected", "rejected"]},
        "transforms": {
          "type": "object", "required": ["source_to_local", "local_to_world"],
          "properties": {"source_to_local": {"$ref": "#/$defs/matrix4"}, "local_to_world": {"$ref": "#/$defs/matrix4"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
